# Clinical Statistics Agent — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# LLM Provider: "gemini" (recommended, free tier) or "openai"
MODEL_PROVIDER=gemini

# Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=auto

# Agent mode: "mock" for offline demo, "live" for real API calls
AGENT_MODE=mock

# Database path (SQLite)
APP_DB_PATH=data/clinical_stat_agent.db

# (Optional) OpenAI alternative
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
